        <name>Year Validation </name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue === '') {
        return;
    }

    // Converte para número
    var year = parseInt(newValue, 10);

    // Ano atual
    var currentYear = new Date().getFullYear();

    // Valida: precisa ser entre 1888 e (ano atual + 1)
    if (isNaN(year) || year < 1888 || year > currentYear + 1) {
		g_form.clearValue('release_year');
        g_form.showFieldMsg('release_year', 
            'Please enter a valid movie release year (1888 - ' + (currentYear) + ')', 
            'error');
    } else {
        g_form.hideFieldMsg('release_year');
    }
}]]></script>
